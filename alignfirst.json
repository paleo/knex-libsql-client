{
  "schemaVersion": 1,
  "conventions": {
    "ticketIdPattern": "^\\d+$",
    "git": {
      "defaultBranch": "main",
      "branchNameTemplate": "{TICKET_ID}/{1-3-words}",
      "commit": { "style": "conventionalCommit", "ticketReference": "bracketedHash" },
      "agentCoauthoring": false
    }
  },
  "plans": { "repositoryFolder": "knex-libsql-client", "autoArchive": true },
  "developerInstructions": "DEVELOPERS.md",
  "workspace": {
    "sharedDirs": [".local"],
    "finalize": [
      { "name": "Install dependencies", "run": ["npm", "install"] },
      { "name": "Build package", "run": ["npm", "run", "build"] }
    ],
    "summary": "Workspace ${{ name }} — ${{ status }}\n  Main:   ${{ isMainWorktree }}\n  Branch: ${{ branch }}\n  Path:   ${{ currentWorktree }}"
  }
}
