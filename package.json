{
  "name": "knex-libsql-client",
  "version": "0.1.2",
  "license": "MIT",
  "description": "Knex dialect for @libsql/client.",
  "keywords": [
    "knex",
    "sqlite",
    "libsql"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/paleo/knex-libsql-client.git"
  },
  "type": "module",
  "packageManager": "npm@11.11.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "peerDependencies": {
    "@libsql/client": ">=0.17.0 <0.18.0",
    "knex": ">=3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.6.9",
    "@libsql/client": "~0.17.4",
    "@types/node": "~26.6.11",
    "knex": "~3.3.0",
    "typescript": "~7.0.2",
    "vitest": "~5.1.2"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "check": "npm run lint && npm run build && npm test",
    "prepublishOnly": "npm run check"
  },
  "files": [
    "dist"
  ]
}
